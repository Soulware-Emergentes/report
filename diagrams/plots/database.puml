@startuml plots-database
skinparam classAttributeIconSize 0
hide circle
hide empty methods

class plots <<Table>> {
    {field} id : UUID [PK]
    {field} owner_document_type : VARCHAR(20) [NN]
    {field} owner_document_number : VARCHAR(12) [NN]
    {field} boundary : geometry(Polygon) [NN]
    {field} footprint : geography(Polygon,4326) [GENERATED]
    {field} ubigeo : VARCHAR(6) [NN]
    {field} registration_date : TIMESTAMP [NN]
}

class districts <<Table>> {
    {field} ubigeo : VARCHAR(6) [PK]
    {field} name : VARCHAR(255) [NN]
    {field} province : VARCHAR(255) [NN]
    {field} department : VARCHAR(255) [NN]
    {field} boundary : geometry(MultiPolygon,4326) [NN]
}

plots .right.> districts : ubigeo deducido de >

note bottom of plots
    UNIQUE (owner_document_type, owner_document_number)
end note

note bottom of districts
    Datos de referencia: límites distritales del INEI 2025,
    cargados por migración en todos los entornos.
end note

@enduml
