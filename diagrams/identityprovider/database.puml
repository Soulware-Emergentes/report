@startuml identityprovider-database
skinparam classAttributeIconSize 0
hide circle
hide empty methods

class api_resources <<Table>> {
    {field} id : UUID [PK]
    {field} identifier : VARCHAR(255) [UQ, NN]
    {field} name : VARCHAR(255) [NN]
}

class api_roles <<Table>> {
    {field} id : UUID [PK]
    {field} resource_id : UUID [FK, NN]
    {field} value : VARCHAR(100) [NN]
    {field} description : TEXT
}

class api_scopes <<Table>> {
    {field} id : UUID [PK]
    {field} resource_id : UUID [FK, NN]
    {field} value : VARCHAR(100) [NN]
    {field} description : TEXT
}

class client_registrations <<Table>> {
    {field} id : UUID [PK]
    {field} client_id : VARCHAR(255) [UQ, NN]
    {field} kind : VARCHAR(20) [NN]
    {field} secret_hash : VARCHAR(255)
}

class client_redirect_uris <<Table>> {
    {field} client_registration_id : UUID [PK, FK]
    {field} uri : VARCHAR(1000) [PK]
    {field} kind : VARCHAR(20) [PK]
}

class client_resources <<Table>> {
    {field} client_registration_id : UUID [PK, FK]
    {field} resource_id : UUID [PK, FK]
}

class role_assignments <<Table>> {
    {field} role_id : UUID [PK, FK]
    {field} group_id : UUID [PK]
}

class scope_grants <<Table>> {
    {field} client_registration_id : UUID [PK, FK]
    {field} scope_id : UUID [PK, FK]
}

note bottom of api_roles
    UNIQUE (resource_id, value)
end note

note bottom of api_scopes
    UNIQUE (resource_id, value)
end note

api_roles "0..*" --> "1" api_resources : resource_id
api_scopes "0..*" --> "1" api_resources : resource_id
client_redirect_uris "0..*" --> "1" client_registrations : client_registration_id
client_resources "0..*" --> "1" client_registrations : client_registration_id
client_resources "0..*" --> "1" api_resources : resource_id
role_assignments "0..*" --> "1" api_roles : role_id
scope_grants "0..*" --> "1" client_registrations : client_registration_id
scope_grants "0..*" --> "1" api_scopes : scope_id
@enduml
